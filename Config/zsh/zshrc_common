# export P4CONFIG=.p4config

function settitle() {
    print -n $'\033]0;'"$1"$'\a'
}

function lcd() {
    if [ -n "$1" ]
    then
        theString=$(grep ${1}: ~/.lcd)
        # echo "theString = $theString"
        # echo $theString | grep -q ${1}:
        typeset -i ret=$?
        if [ $ret -eq 0 ]
        then
            theDir=$(echo $theString | cut -d : -f 2)
            # echo "theDir = '$theDir'"
            fullPath=$(realpath $theDir)
            # echo "fullPath = '$fullPath'"
            cd $fullPath
            pwd
        else
            echo "No entry found for $1!"
        fi
    else
        echo "ERROR: No argument given to lcd!"
    fi
}

pathContains()
{
    pclret="No"

    pcl=$(echo $PATH | tr ":" "\n")

    for p in $pcl
    do
        if [ "$p" = "$1" ]
        then
            pclret="Yes"
        fi
    done

    echo "$pclret"
}


addToPath()
{
    while [ $# -gt 0 ]
    do
        D=$1

        if [ -d "$D" -a "$(pathContains $D)" = "No" ]
        then
            export PATH=$PATH:"$D"
        fi

        shift
    done
}


