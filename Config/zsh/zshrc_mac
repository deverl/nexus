# Zsh completion (replaces bash_completion.sh)
if [ -n "$HOMEBREW_BASE_DIR" ]
then
    fpath=("$HOMEBREW_BASE_DIR/share/zsh/site-functions" $fpath)
fi
zstyle :compinstall filename "${ZDOTDIR:-$HOME}/.zshrc"
autoload -Uz compinit
compinit -C
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

