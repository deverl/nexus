###################################################################
# bashrc_common

export HISTSIZE=10000
export HISTFILESIZE=-1

# My usual prompt
export PS1='[\#]$ '

# If you want the prompt to set the tab title to the cwd
# export PS1='\[$(settitle "$PWD")\][\#]$ '


###################################################################
## grok.com gave me this solution to keep history from all open tabs.

# Append to the history file instead of overwriting it
shopt -s histappend

# Larger history sizes (adjust as needed; -1 for unlimited)
export HISTSIZE=100000
export HISTFILESIZE=100000

# Ignore duplicates and commands starting with space
export HISTCONTROL=ignoredups:ignorespace

# Append each command immediately and reload history from file for near-real-time sharing
export PROMPT_COMMAND="history -a; history -n; ${PROMPT_COMMAND}"

###################################################################


# export P4CONFIG=.p4config

function settitle() {
    echo -n -e $"\033]0;$1\a"
}


pathContains()
{
    pclret="No"

    pcl=$(echo $PATH | tr ":" "\n")

    for p in $pcl
    do
        if [ "$p" = "$1" ]
        then
            pclret="Yes"
        fi
    done

    echo "$pclret"
}


addToPath()
{
    while [ $# -gt 0 ]
    do
        D=$1

        if [ -d "$D" -a "$(pathContains $D)" = "No" ]
        then
            export PATH=$PATH:"$D"
        fi

        shift
    done
}


addToPath ~/bin
addToPath ~/nexus/bin/common
addToPath ~/go/bin

