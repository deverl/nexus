export BASH_SILENCE_DEPRECATION_WARNING=1


if [ -d /opt/homebrew ]
then
    HOMEBREW_BASE_DIR=/opt/homebrew
elif [ -d /usr/local ]
then
    HOMEBREW_BASE_DIR=/usr/local
else
    unset HOMEBREW_BASE_DIR
fi

