#!/usr/bin/env bash

if [ $# -gt 0 ]
then
    if [[ $1 =~ ^-?[0-9]+$ ]]
    then
        if [ $1 -gt 0 ]
        then
            sudo pmset -b -c displaysleep $1 2>/dev/null
        else
            echo "ERROR: Invalid value ($1) given for timeout!"
            echo "       Must be in the range of [1..180]"
            exit 1
        fi
    else
        echo "ERROR: Sleep time must be an integer!"
        exit 1
    fi
fi

pmset -g | grep displaysleep | awk '{ print $1," is set to ", $2," minutes." }'

