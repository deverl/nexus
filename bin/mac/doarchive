#!/usr/bin/env bash
#
# Archives selected folders to the home iMac.
#

typeset -i do_arbackup=0
typeset -r backupDir=opt/Seagate/Backup/DeVerl

theServer=stokes-imac.local

while [ $# -gt 0 ]
do
    if [ $1 == "-ar" -o $1 == "--do-arbackup" ]
    then
        do_arbackup=1
    elif [ $1 == "-h" -o $1 == "--help" ]
    then
        echo "usage: doarchive [opts]"
        echo ""
        echo " opts: -ar, --do-arbackup    Runs ar.backup at the end."
        echo "       -h, --help            Show this screen and exit."
        echo ""
        exit 0
    else
        echo "ERROR: Unrecognized argument: $1"
        exit 1
    fi

    shift
done


function pingit {
    results=$(ping -c 1 -t 5 ${theServer})
    ### results=$(ping -c 1 -t 5 bodsimac.local &> /dev/null)
    echo $?
}

echo -n "Trying ${theServer}..."
ret=$(pingit)
if [ ${ret} -eq 0 ]
then
    echo "got it!"
else
    echo " Can't find it. Exiting."
    exit 1
fi



