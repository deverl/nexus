echo ""
echo "Archiving idrive..."

rsync -av                           \
      --executability               \
      --delete  -m                  \
      --delete-excluded             \
      --exclude=".idrive"          \
      --exclude=".idrive.cache"    \
      ~/idrive/ dstokes@${theServer}:idrive/



echo ""
echo ""
echo "Archiving ~/tmp/adasheriff directory..."

ssh dstokes@${theServer} mkdir -p ${backupDir}/adasheriff/

rsync -av \
      --executability                   \
      --delete   -m                     \
      /Users/dstokes/tmp/adasheriff/    \
      dstokes@${theServer}:${backupDir}/adasheriff/



echo ""
echo ""
echo "Archiving Mail..."

ssh dstokes@${theServer}        \
    mkdir -p                    \
    ${backupDir}/bodsmbp

rsync -av               \
      --delete -m       \
      ~/Library/Mail/   \
      dstokes@${theServer}:${backupDir}/bodsmbp/Mail/



