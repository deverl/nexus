#!/usr/bin/env bash

if [ $# -eq 1 ]
then
    fn=$(find "$1" -type f -print | wc -l)
    dn=$(find "$1" -type d -print | wc -l)
    sz=$(du -hs "$1" | sed 's/\([0-9.][0-9.]*.\).*$/\1/')

    echo ""
    echo "Directory : $1"
    echo "    Files : $fn"
    echo "     Dirs : $dn"
    echo "     Size : $sz"
    echo ""
fi


