#!/usr/bin/env bash

DESTINATION=origin
BRANCH=develop

function usage() {
    echo ""
    echo "usage: git.push [opts]"
    echo ""
    echo "     opts: -b,  --branch <branch>     Work with local branch <branch>"
    echo "           -bb, --use-bitbucket       Set destination to bitbucket"
    echo "           -d,  --destination <dest>  Set destination to <dest>"
    echo "           -h,  --help                Show this screen and exit"
    echo ""
}


while [ $# -gt 0 ]
do
    if [ "$1" = "-b" -o "$1" = "--branch" ]
    then
        shift
        if [ $# -gt 0 ]
        then
            BRANCH=$1
            echo "Set destination to ${BRANCH}"
        else
            echo "ERROR: No value given for --branch"
            exit 1
        fi
    elif [ "$1" = "-bb" -o "$1" = "--use-bitbucket" ]
    then
        DESTINATION=bitbucket
    elif [ "$1" = "-d" -o "$1" = "--destination" ]
        then
        shift
        if [ $# -gt 0 ]
        then
            DESTINATION=$1
            echo "Set destination to ${DESTINATION}"
        else
            echo "ERROR: No value given for --destination"
            exit 1
        fi
    elif [ "$1" = "-h" -o "$1" = "--help" ]
        then
        usage
        exit 0
    fi

    shift
done

git push --verbose --follow-tags ${DESTINATION} ${BRANCH}
git push --verbose -u ${DESTINATION} --all
git push --verbose -u ${DESTINATION} --tags

