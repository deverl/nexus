#!/usr/bin/env bash

exe_name=main.x
SRC=""
CPP_OPTS="-I$SYSTEMC/include --std=c++11 -Wall"
LD_OPTS="-L$SYSTEMC/lib-$SYSTEMC_ARCH -lsystemc -lm"

while [ $# -gt 0 ]
do
    if [ $1 == "-x" -o $1 == "--exe-name" ]
    then
        shift
        if [ $# -gt 0 ]
        then
            exe_name=$1
        else
            echo "ERROR: No value given for --exe-name!"
            exit 1
        fi
    elif [ $1 == "-i" -o $1 == "--include" ]
    then
        shift
        if [ $# -gt 0 ]
        then
            CPP_OPTS="${CPP_OPTS} -I\"${1}\""
        else
            echo "ERROR: No value given for --include!"
            exit 1
        fi
    elif [ $1 == "-h" -o $1 == "--help" ]
    then
        echo ""
        echo "usage: syscc [opts] [src...]"
        echo ""
        echo " opts: -x, --exe-name <name>   Use <name> for the output."
        echo "       -i, --include <dir>     Add <dir> to the header search path."
        echo "       -h, --help              Show this screen and exit."
        echo ""
        echo "notes: 1. If no source files are given, all cpp files in the"
        echo "          current directory are compiled."
        echo "       2. Default executable name is main.x"
        echo ""
        exit 0
    else
        ### Assume this is a source file or file pattern.
        SRC="${SRC} $1"
    fi
    shift
done

if [ -z "${SRC}" ]
then
    SRC="*.cpp"
fi

### echo "exe_name = ${exe_name}"
### echo "SRC = $SRC"
### echo "CPP_OPTS = ${CPP_OPTS}"
### echo "LD_OPTS = ${LD_OPTS}"
### exit 0


if [ -d include ]
then
    CPP_OPTS="${CPP_OPTS} -Iinclude"
fi

if [ -d inc ]
then
    CPP_OPTS="${CPP_OPTS} -Iinc"
fi

set -x

g++ ${CPP_OPTS} -o ${exe_name} $SRC ${LD_OPTS}

