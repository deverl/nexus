#!/usr/bin/env bash


typeset -i integrate=0
typeset -i verbose=0
typeset -i quiet=0

while [ $# -gt 0 ]
do
    if [ "$1" == "-i" ]
    then
        integrate=1
    elif [ "$1" == "-q" ]
    then
        quiet=1
    elif [ "$1" == "-v" ]
    then
        verbose=1
    fi

    shift
done


# echo "integrate = $integrate"
# exit 0



function do_integ()
{
    if [ $integrate -eq 1 -a $# -eq 1 ]
    then
        b="$1"
        p4 integrate -d -i -b ${b}
        p4 resolve -as
        p4 submit -d "Merging using ${b}"
    fi
}


